[Unit]
# `plexamp-mdns.service` declares `Requires=avahi-daemon.service`, and systemd refuses to start a
# unit whose `Requires=` names something it cannot load, so enabling PlexAmp needs this stub present.
#
# It publishes nothing. `plexamp-mdns.service`'s own ExecStart runs the real helper script, whose
# `avahi-publish` is separately stubbed.
Description=Avahi mDNS/DNS-SD Stack

[Service]
ExecStart=/usr/local/bin/avahi-publish
Restart=on-failure

[Install]
WantedBy=multi-user.target
